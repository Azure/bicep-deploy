{
  "name": "@azure/bicep-deploy-common",
  "description": "Common Code for bicep-deploy (GitHub Action/ADO Task)",
  "version": "0.0.0-placeholder",
  "author": "Microsoft",
  "homepage": "https://github.com/Azure/bicep-deploy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azure/bicep-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/Azure/bicep-deploy/issues"
  },
  "keywords": [
    "bicep",
    "arm templates"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs",
    "./deployments": "./dist/deployments.cjs",
    "./stacks": "./dist/stacks.cjs"
  },
  "files": [
    "./dist",
    "./package.json",
    "./README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rimraf ./dist",
    "build": "eslint src test test-consumer && npm run typecheck && tsdown --config ./tsdown.config.mts",
    "test": "vitest --config ../../vitest.config.unit.ts test",
    "test:consumer": "npm --prefix ../bicep-rpc-client run build && npm run build && node ./test-consumer/run.cjs",
    "pack:validate": "node ./test-consumer/run.cjs --retain-tarballs --json",
    "lint": "eslint src test test-consumer",
    "lint:fix": "eslint src test test-consumer --fix",
    "stamp-version": "nbgv-setversion",
    "reset-version": "nbgv-setversion --reset"
  },
  "license": "MIT",
  "dependencies": {
    "@azure/arm-resources": "^8.0.0",
    "@azure/arm-resourcesdeployments": "^2.0.0",
    "@azure/arm-resourcesdeploymentstacks": "^2.0.0",
    "@azure/bicep-rpc-client": "*",
    "@azure/identity": "^4.13.3",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-prettier": "^5.5.6",
    "nerdbank-gitversioning": "^3.10.94",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
