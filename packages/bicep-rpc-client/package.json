{
  "name": "@azure/bicep-rpc-client",
  "description": "JSON-RPC implementation for Bicep CLI integration",
  "version": "0.0.0-placeholder",
  "author": "Microsoft",
  "homepage": "https://github.com/Azure/bicep-deploy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azure/bicep-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/Azure/bicep-deploy/issues"
  },
  "keywords": [
    "bicep",
    "arm templates"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "files": [
    "./dist",
    "./package.json",
    "./README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rimraf ./dist",
    "build": "eslint src test && npm run typecheck && tsdown --config ./tsdown.config.mts",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "stamp-version": "nbgv-setversion",
    "reset-version": "nbgv-setversion --reset"
  },
  "license": "MIT",
  "dependencies": {
    "vscode-jsonrpc": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-prettier": "^5.5.6",
    "nerdbank-gitversioning": "^3.10.94",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
