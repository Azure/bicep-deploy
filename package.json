{
  "name": "bicep-deploy",
  "description": "Bicep Deploy GitHub Action",
  "version": "0.0.1",
  "author": "Microsoft",
  "homepage": "https://github.com/azure/bicep-deploy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azure/bicep-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/azure/bicep-deploy/issues"
  },
  "keywords": [
    "bicep",
    "arm templates"
  ],
  "type": "commonjs",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean:packages": "npm run clean --workspace @azure/bicep-rpc-client --workspace @azure/bicep-deploy-common",
    "build": "eslint src test test-live && npm run typecheck && tsdown --config ./tsdown.config.ts",
    "build:packages": "npm run build --workspace @azure/bicep-rpc-client --workspace @azure/bicep-deploy-common",
    "build:all": "npm run build:packages && npm run build",
    "test": "vitest --config vitest.config.unit.ts",
    "test:live": "vitest --config vitest.config.live.ts",
    "lint": "eslint src test test-live && npm run lint --workspace @azure/bicep-rpc-client --workspace @azure/bicep-deploy-common",
    "lint:fix": "eslint src test test-live --fix && npm run lint:fix --workspace @azure/bicep-rpc-client --workspace @azure/bicep-deploy-common --fix",
    "validate": "npm run lint && npm run test:consumer --workspace @azure/bicep-deploy-common && npm run build && npm test -- --run",
    "validate:fix": "npm run lint:fix && npm run validate"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "@azure/bicep-deploy-common": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
